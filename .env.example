# A0 外部提醒开关：填 1 才会真正发送短信/电话/Webhook
A0_NOTIFY_ENABLED=0

# 可选：sms,call,webhook，用英文逗号分隔
A0_NOTIFY_CHANNELS=sms,call

# 同一组 A0 机会的重复提醒冷却时间，默认 30 分钟
A0_NOTIFICATION_COOLDOWN_MS=1800000

# Twilio 短信/电话配置
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_TO=

# 可选：自建服务、飞书/企业微信/Telegram 中转等 Webhook
A0_WEBHOOK_URL=
A0_WEBHOOK_TOKEN=

# 可选：Binance API（留空则走公开接口，仅影响限频/私有数据）
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 脱锚套利监控（2026-10-03 新增）：填 1 才启动每轮扫描 + PushPlus 推送
DEPEG_MONITOR_ENABLED=0

# 每轮扫描间隔（毫秒），默认 5 分钟
DEPEG_SCAN_INTERVAL_MS=300000

# 脱锚阈值（bps）：预警 / 严重 / 回到多少以内解除
DEPEG_WARN_BPS=50
DEPEG_SEVERE_BPS=150
DEPEG_CLEAR_BPS=30

# 预警持续时重报间隔 / 严重持续时跟进间隔（毫秒）
DEPEG_WARN_REPUSH_MS=1800000
DEPEG_SEVERE_REPUSH_MS=900000

# 链上报价池最小流动性（USD），低于此的池不参与定价
DEPEG_MIN_LIQ_USD=20000

# 事件落盘文件（含 enriched=false 供新闻定性+套利路径富化流程消费）
DEPEG_STATE_FILE=./state/depeg_events.json

# PushPlus：优先读 PUSHPLUS_TOKEN 环境变量，否则读此文件（不要把 token 写进代码）
# PUSHPLUS_TOKEN=
PUSHPLUS_TOKEN_FILE=/home/hatch/workspace/dividend-detector/.pushplus_token
