function vwapFromOrderbook(levels, targetBaseAmount) {
  let remaining = targetBaseAmount;
  let cost = 0;
  let filled = 0;

  for (const [rawPrice, rawSize] of levels || []) {
    const price = numberFromPath(rawPrice);
    const size = numberFromPath(rawSize);
    if (price <= 0 || size <= 0) continue;

    const take = Math.min(remaining, size);
    cost += take * price;
    filled += take;
    remaining -= take;
    if (remaining <= 1e-12) break;
  }

  return {
    vwap: filled > 0 ? cost / filled : 0,
    filledBase: filled,
    targetBase: targetBaseAmount,
    complete: remaining <= 1e-12,
  };
}

async function getBinanceExecutionPrices(pairs) {
  const targets = pairs.filter((pair) => BINANCE_EXECUTION_BASE_SIZES.has(pair));
  if (!targets.length) return new Map();

  const entries = await Promise.all(
    targets.map(async (pair) => {
      try {
        const data = await cached(`binance-depth-${pair}`, 10_000, () =>
          fetchJson(`https://api.binance.com/api/v3/depth?symbol=${pair}&limit=100`),
        );
        const targetSize = BINANCE_EXECUTION_BASE_SIZES.get(pair);
        const ask = vwapFromOrderbook(data.asks, targetSize);
        if (ask.vwap <= 0 || !ask.complete) return null;
        return [pair, { price: ask.vwap, targetSize, filledBase: ask.filledBase }];
      } catch {
        return null;
      }
    }),
  );

  return new Map(entries.filter(Boolean));
}

