// 缓存策略：TTL 内直接命中；TTL 过期后尝试重新拉取，
// 但**保留上一次成功的值**（stale cache）——
// 上游（llama.fi / coingecko / binance）在当前网络经常不可达，
// 如果让异常直接冒出去，整个接口会变成 502、前端整页空白。
// 有旧值时宁可返回稍旧的数据并标记 stale，也不要让看板打不开。
const STALE_CACHE = new Map();

function cached(key, ttl, loader) {
  const hit = cache.get(key);
  if (hit && Date.now() - hit.time < ttl) {
    return hit.value;
  }
  const value = loader().then((data) => {
    cache.set(key, { time: Date.now(), value: Promise.resolve(data) });
    STALE_CACHE.set(key, { time: Date.now(), value: Promise.resolve(data) });
    return data;
  }).catch((error) => {
    // 刷新失败：如果以前成功过，就退回旧数据，避免整页 502
    const last = STALE_CACHE.get(key);
    if (last) {
      cache.set(key, { time: Date.now(), value: last.value });
      return last.value;
    }
    throw error;
  });
  cache.set(key, { time: Date.now(), value });
  return value;
}

async function fetchJson(url, options = {}) {
  const response = await fetch(url, {
    ...options,
    headers: {
      accept: 'application/json',
      ...(options.headers || {}),
      'user-agent': 'stablecoin-risk-desk/0.1',
    },
  });

  if (!response.ok) {
    const text = await response.text();
    throw new Error(`${response.status} ${response.statusText}: ${text.slice(0, 180)}`);
  }

  return response.json();
}

function numberFromPath(value, fallback = 0) {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : fallback;
}

function formatChainRows(asset) {
  return Object.entries(asset.chainCirculating || {})
    .map(([chain, item]) => {
      const current = numberFromPath(item?.current?.peggedUSD);
      const prevDay = numberFromPath(item?.circulatingPrevDay?.peggedUSD);
      const prevWeek = numberFromPath(item?.circulatingPrevWeek?.peggedUSD);
      const share =
        asset.circulating?.peggedUSD > 0
          ? (current / asset.circulating.peggedUSD) * 100
          : 0;
      return {
        chain,
        current,
        share,
        dayChange: current - prevDay,
        weekChange: current - prevWeek,
      };
    })
    .filter((row) => row.current > 0)
    .sort((a, b) => b.current - a.current)
    .slice(0, 8);
}

function riskLevel(asset) {
  const price = numberFromPath(asset.price, 1);
  const hasPrice = price > 0.01;
  const deviationBps = hasPrice ? Math.abs(price - 1) * 10_000 : 0;
  const supply = numberFromPath(asset.circulating?.peggedUSD);
  const prevDay = numberFromPath(asset.circulatingPrevDay?.peggedUSD);
  const dayChangePct = prevDay > 0 ? ((supply - prevDay) / prevDay) * 100 : 0;
  const isNavStyle = NAV_STYLE_STABLE_SYMBOLS.has(String(asset.symbol).toUpperCase());

  if (!isNavStyle && deviationBps >= 75) return 'high';
  if (Math.abs(dayChangePct) >= 10) return 'high';
  if (!isNavStyle && deviationBps >= 25) return 'watch';
  if (Math.abs(dayChangePct) >= 4) return 'watch';
  return 'normal';
}

function normalizeStableAsset(asset) {
  const supply = numberFromPath(asset.circulating?.peggedUSD);
  const prevDay = numberFromPath(asset.circulatingPrevDay?.peggedUSD);
  const prevWeek = numberFromPath(asset.circulatingPrevWeek?.peggedUSD);
  const price = numberFromPath(asset.price, 1);
  const isNavStyle = NAV_STYLE_STABLE_SYMBOLS.has(String(asset.symbol).toUpperCase());
  const hasPrice = price > 0.01;
  const rawDeviationBps = hasPrice ? (price - 1) * 10_000 : 0;
  const pegDeviationBps = isNavStyle ? 0 : rawDeviationBps;

  return {
    id: asset.id,
    name: asset.name,
    symbol: asset.symbol,
    pegMechanism: asset.pegMechanism,
    price,
    hasPrice,
    priceType: isNavStyle ? 'nav' : 'peg',
    priceNote: isNavStyle ? 'NAV/收益型价格，不按 1 美元脱锚判断' : 'USD 锚定价格',
    isNavStyle,
    rawDeviationBps,
    deviationBps: pegDeviationBps,
    absoluteDeviationBps: Math.abs(pegDeviationBps),
    supply,
    dayChange: supply - prevDay,
    weekChange: supply - prevWeek,
    dayChangePct: prevDay > 0 ? ((supply - prevDay) / prevDay) * 100 : 0,
    weekChangePct: prevWeek > 0 ? ((supply - prevWeek) / prevWeek) * 100 : 0,
    risk: riskLevel(asset),
    chains: formatChainRows(asset),
  };
}

async function getStablecoins() {
  const raw = await cached('stablecoins', TTL.stablecoins, () =>
    fetchJson(LLAMA_STABLECOINS_URL),
  );
  const all = raw.peggedAssets
    .filter((asset) => asset.pegType === 'peggedUSD')
    .filter((asset) => !HIDDEN_STABLE_SYMBOLS.has(String(asset.symbol).toUpperCase()))
    .map(normalizeStableAsset)
    .sort((a, b) => b.supply - a.supply);

  const bySymbol = new Map();
  for (const asset of all) {
    const symbol = String(asset.symbol).toUpperCase();
    if (asset.supply < MIN_DISPLAY_SUPPLY || !asset.hasPrice) continue;

    const previous = bySymbol.get(symbol);
    if (
      !previous ||
      (asset.hasPrice && !previous.hasPrice) ||
      asset.supply > previous.supply
    ) {
      bySymbol.set(symbol, asset);
    }
  }

  const watchlist = [...bySymbol.values()]
    .sort((a, b) => b.supply - a.supply)
    .slice(0, 80);

  const materialAssets = all.filter((asset) => asset.supply >= MIN_DISPLAY_SUPPLY && asset.hasPrice);
  const pegMaterialAssets = materialAssets.filter((asset) => !asset.isNavStyle);
  const largestDeviation = [...pegMaterialAssets].sort(
    (a, b) => b.absoluteDeviationBps - a.absoluteDeviationBps,
  )[0];

  const totalSupply = all.reduce((sum, asset) => sum + asset.supply, 0);
  const highRisk = materialAssets.filter((asset) => asset.risk === 'high').length;
  const watchRisk = materialAssets.filter((asset) => asset.risk === 'watch').length;
  const topMovers = all
    .filter((asset) => asset.supply > 10_000_000)
    .sort((a, b) => Math.abs(b.dayChangePct) - Math.abs(a.dayChangePct))
    .slice(0, 12);

  return {
    updatedAt: new Date().toISOString(),
    source: 'DeFiLlama Stablecoins',
    summary: {
      totalSupply,
      count: all.length,
      highRisk,
      watchRisk,
      minDisplaySupply: MIN_DISPLAY_SUPPLY,
      largestDeviation,
    },
    watchlist,
    topBySupply: all.slice(0, 30),
    topMovers,
  };
}

