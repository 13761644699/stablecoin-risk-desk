async function callRpc(chainId, method, params) {
  const rpcUrl = RPC_URLS.get(chainId);
  if (!rpcUrl) throw new Error(`No RPC configured for chain ${chainId}`);

  const data = await cached(
    `rpc-${chainId}-${method}-${JSON.stringify(params)}`,
    30_000,
    () =>
      fetchJson(rpcUrl, {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          jsonrpc: '2.0',
          id: 1,
          method,
          params,
        }),
      }),
  );

  if (data.error) throw new Error(data.error.message || 'RPC call failed');
  return data.result;
}

function encodeUint256(value) {
  return BigInt(value).toString(16).padStart(64, '0');
}

async function getErc4626Reference(reference) {
  const amount = 10n ** BigInt(reference.decimals || 18);
  const result = await callRpc(reference.chainId, 'eth_call', [
    {
      to: reference.address,
      data: `${ERC4626_CONVERT_TO_ASSETS_SELECTOR}${encodeUint256(amount)}`,
    },
    'latest',
  ]);

  if (!result || result === '0x') return null;
  const value = Number(BigInt(result)) / 10 ** (reference.decimals || 18);
  return Number.isFinite(value) && value > 0 ? value : null;
}

async function getContractReference(reference) {
  const result = await callRpc(reference.chainId, 'eth_call', [
    {
      to: reference.address,
      data: reference.selector,
    },
    'latest',
  ]);

  if (!result || result === '0x') return null;
  const value = Number(BigInt(result)) / 10 ** (reference.decimals || 18);
  return Number.isFinite(value) && value > 0 ? value : null;
}

async function getOnchainReferences(assets) {
  const entries = await Promise.all(
    assets
      .filter((asset) => {
        const reference = referenceConfig(asset);
        return reference.type === 'erc4626' || reference.type === 'contract';
      })
      .map(async (asset) => {
        const reference = referenceConfig(asset);
        try {
          const value =
            reference.type === 'contract'
              ? await getContractReference(reference)
              : await getErc4626Reference(reference);
          return [`${asset.symbol}-${reference.address}`, value];
        } catch {
          return [`${asset.symbol}-${reference.address}`, null];
        }
      }),
  );

  return new Map(entries);
}

async function getRedemptionSpreads() {
  const redemptionAssets = ACTIVE_REDEMPTION_ASSETS;
  const binancePairs = redemptionAssets
    .filter((asset) => asset.market.type === 'binance')
    .map((asset) => asset.market.pair);
  const llamaTokens = redemptionAssets
    .filter((asset) => asset.market.type === 'llama')
    .map((asset) => asset.market);

  const [
    binancePrices,
    binanceExecutionPrices,
    llamaPrices,
    lifiTokens,
    onchainReferences,
    externalReferences,
    pendleMarkets,
  ] = await Promise.all([
    getBinancePrices(binancePairs),
    getBinanceExecutionPrices(binancePairs),
    getLlamaPrices(llamaTokens),
    getRedemptionLifiTokens(),
    getOnchainReferences(redemptionAssets),
    getExternalRedemptionReferences(redemptionAssets, { includeBinanceSignedRates: false }),
    getPendleMarkets().catch(() => ({ markets: [] })),
  ]);
  const signedReferences = await getBinanceSignedRateReferences(redemptionAssets);
  for (const [symbol, reference] of signedReferences) {
    externalReferences.set(symbol, reference);
  }

  const assets = redemptionAssets.map((asset) => {
    let marketPrice = 0;
    let marketToken = null;
    let executionMarket = null;
    if (asset.market.type === 'binance') {
      executionMarket = binanceExecutionPrices.get(asset.market.pair) || null;
      marketPrice = executionMarket?.price || binancePrices.get(asset.market.pair) || 0;
    }
    if (asset.market.type === 'llama') {
      marketPrice = llamaPrices.get(`${asset.market.chainId}:${asset.market.address}`) || 0;
    }
    if (asset.market.type === 'lifi-token') {
      marketToken = chooseLifiToken(lifiTokens, asset.market.chainId, asset.market.symbol);
      marketPrice = numberFromPath(marketToken?.priceUSD);
    }
    if (asset.market.type === 'manual') {
      marketPrice = numberFromPath(asset.market.price);
    }
    const originalMarketPrice = marketPrice;
    marketPrice = applyMarketOverrides(asset, marketPrice);

    const effectiveReference = referenceConfig(asset);
    const marketQuote =
      asset.market.quote ||
      (
        asset.market.type === 'lifi-token' || asset.market.type === 'llama'
          ? 'USD'
          : effectiveReference.quote || 'USD'
      );
    const referenceQuote = effectiveReference.quote || asset.market.quote || 'USD';
    let normalizedMarketPrice = normalizeMarketPrice(
      marketPrice,
      marketQuote,
      referenceQuote,
      lifiTokens,
    );

    let referencePrice = effectiveReference.value || 0;
    if (effectiveReference.type === 'same-as-market') referencePrice = normalizedMarketPrice || 0;
    if (effectiveReference.type === 'binance-market') referencePrice = normalizedMarketPrice || 0;
    if (effectiveReference.type === 'erc4626' || effectiveReference.type === 'contract') {
      referencePrice =
        onchainReferences.get(`${asset.symbol}-${effectiveReference.address}`) || 0;
    }
    if (effectiveReference.type === 'unknown-rate') referencePrice = 0;
    if (referencePrice <= 0 && normalizedMarketPrice > 0) referencePrice = normalizedMarketPrice;
    const needsExecutionMarket =
      asset.market.type === 'binance' &&
      BINANCE_EXECUTION_BASE_SIZES.has(asset.market.pair);
    const missingExecutionMarket = needsExecutionMarket && !executionMarket;
    const usedMarketFallback =
      referencePrice > 0 &&
      effectiveReference.type === 'unknown-rate' &&
      normalizedMarketPrice > 0 &&
      referencePrice === normalizedMarketPrice;
    const usedReferenceFallback =
      referencePrice > 0 &&
      effectiveReference.type !== 'unknown-rate' &&
      normalizedMarketPrice > 0 &&
      referencePrice === normalizedMarketPrice;
    const wasReferenceMissing = referencePrice <= 0 || usedMarketFallback;
    const overrideReference = externalReferenceFor(asset, externalReferences) ||
      fallbackRedemptionReference(asset);
    referencePrice = applyRedemptionOverrides(asset, referencePrice, externalReferences);
    let waitDays = redemptionWaitDays(asset);
    let pendleMarket = null;
    if (isPendleAsset(asset)) {
      const pendle = applyPendleData(
        asset,
        marketPrice,
        referencePrice,
        waitDays,
        pendleMarkets,
      );
      marketPrice = pendle.marketPrice;
      referencePrice = pendle.referencePrice;
      waitDays = pendle.waitDays;
      pendleMarket = pendle.pendleMarket;
      normalizedMarketPrice = normalizeMarketPrice(
        marketPrice,
        marketQuote,
        referenceQuote,
        lifiTokens,
      );
    }

    const spreadPct =
      referencePrice > 0 && normalizedMarketPrice > 0
        ? ((referencePrice - normalizedMarketPrice) / referencePrice) * 100
        : null;
    const quality = overrideReference?.quality ||
      referenceQuality(asset, referencePrice, wasReferenceMissing);
    const conservativeReason = conservativePolicyFor(asset, quality);
    const executionCaution = conservativeReason
      ? null
      : executionCautionFor(asset, asset.market.type, executionMarket);
    const isExecutable = !usedReferenceFallback && !conservativeReason && !missingExecutionMarket && !executionCaution;
    const annualizedPct = isExecutable ? annualizedFromSpread(spreadPct, waitDays) : null;
    const tag = executableOpportunityTag(
      asset,
      spreadPct,
      missingExecutionMarket || executionCaution ? null : annualizedPct,
      quality,
      usedReferenceFallback || missingExecutionMarket || Boolean(executionCaution),
    );
    const score = scoreRedemptionOpportunity({
      asset,
      spreadPct,
      annualizedPct,
      quality,
      isExecutable,
      missingExecutionMarket,
      conservativeReason,
      executionCaution,
    });
    const adjustedReferenceLabel = [
      overrideReference
        ? overrideReference.label
        :
        effectiveReference.type === 'unknown-rate' && referencePrice === normalizedMarketPrice
          ? `${asset.reference.label}；当前先用市场隐含值兜底，不作为官方赎回率`
          : effectiveReference.label,
      conservativeReason ? `口径收紧：${conservativeReason}，不计入 A0/A1 复核和年化` : null,
      executionCaution ? `口径收紧：${executionCaution}，不计入 A0/A1 复核和年化` : null,
    ].filter(Boolean).join('；');

    return {
      symbol: asset.symbol,
      name: asset.name,
      kind: asset.kind,
      showInFocus: shouldShowInRedemptionFocus({
        symbol: asset.symbol,
        annualizedPct,
        opportunityLevel: score.opportunityLevel,
      }),
      source: asset.source,
      quote: referenceQuote,
      marketQuote,
      marketPrice,
      normalizedMarketPrice,
      marketQuality: executionMarket
        ? `订单簿卖盘均价，约 ${executionMarket.targetSize} ${asset.symbol}`
        : missingExecutionMarket
          ? '待接订单簿成本，暂不进 A0/A1 复核'
          : marketQuality(asset, originalMarketPrice, marketPrice),
      redemptionReference: referencePrice,
      referenceLabel: adjustedReferenceLabel,
      referenceQuality: quality,
      opportunityTag: tag,
      opportunityScore: score.opportunityScore,
      opportunityLevel: score.opportunityLevel,
      opportunityReason: score.opportunityReason,
      pendleMarket,
      spreadPct,
      annualizedPct,
      waitDays,
      opportunity:
        missingExecutionMarket ? '待接订单簿成本' : opportunityText(asset, spreadPct, isExecutable),
      wait: asset.wait,
      redemptionPath: asset.redemptionPath,
      entryUrl: asset.entryUrl,
      marketChain: marketToken
        ? LIFI_CHAIN_LABELS.get(marketToken.chainId) || marketToken.chainId
        : undefined,
    };
  }).filter((asset) =>
    asset.annualizedPct !== null &&
    Number.isFinite(asset.annualizedPct) &&
    asset.spreadPct !== null &&
    asset.redemptionReference > 0 &&
    asset.normalizedMarketPrice > 0
  );

  return {
    updatedAt: new Date().toISOString(),
    source: 'DeFiLlama Coins + Pendle official markets + public RPC',
    assets,
  };
}

