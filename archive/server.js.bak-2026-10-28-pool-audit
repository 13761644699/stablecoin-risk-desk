function tokenKey(token) {
  return `${token.chainId}:${String(token.symbol).toUpperCase()}:${token.address}`;
}

function tokenSymbolsMatch(tokenSymbol, desiredSymbol) {
  return String(tokenSymbol).toUpperCase() === String(desiredSymbol).toUpperCase();
}

function findCanonicalToken(candidates, chainId, symbol) {
  const canonicalAddress = CANONICAL_TOKEN_ADDRESSES.get(
    `${chainId}:${String(symbol).toUpperCase()}`,
  );
  if (!canonicalAddress) return null;

  return candidates.find(
    (item) => String(item.address).toLowerCase() === canonicalAddress.toLowerCase(),
  ) || null;
}

function chooseToken(tokens, chainId, symbol) {
  const desired = String(symbol).toUpperCase();
  const candidates = (tokens[String(chainId)] || [])
    .filter((token) => tokenSymbolsMatch(token.symbol, desired))
    .filter((token) => ROUTE_TOKENS.includes(String(token.symbol).toUpperCase()));

  if (!candidates.length) return null;

  return (
    findCanonicalToken(candidates, chainId, desired) ||
    candidates.find((token) => String(token.coinKey).toUpperCase() === desired) ||
    candidates.find((token) => token.address && token.decimals <= 6) ||
    candidates[0]
  );
}

function chooseLifiToken(tokens, chainId, symbol) {
  const desired = String(symbol).toUpperCase();
  const candidates = (tokens[String(chainId)] || []).filter((token) =>
    tokenSymbolsMatch(token.symbol, desired),
  );

  if (!candidates.length) return null;

  return (
    findCanonicalToken(candidates, chainId, desired) ||
    candidates.find((token) => String(token.coinKey).toUpperCase() === desired) ||
    candidates.find((token) => numberFromPath(token.priceUSD) > 0) ||
    candidates[0]
  );
}

function tokenUsdPrice(tokens, chainId, symbol) {
  const token = chooseLifiToken(tokens, chainId, symbol);
  return numberFromPath(token?.priceUSD);
}

function referenceUnitUsdPrice(tokens, quote) {
  const normalized = String(quote || '').toUpperCase();
  if (['USD', 'USDC', 'USDT', 'DAI', 'USDE', 'USDS', 'USDM', 'FRXUSD', 'FRAX'].includes(normalized)) {
    return 1;
  }
  if (
    normalized.includes('USDC') ||
    normalized.includes('USDE') ||
    normalized.includes('USDS') ||
    normalized.includes('FRXUSD')
  ) {
    return 1;
  }
  if (normalized === 'ETH') return tokenUsdPrice(tokens, 1, 'ETH');
  if (normalized === 'FRXETH') return tokenUsdPrice(tokens, 1, 'frxETH');
  if (normalized === 'SOL') return tokenUsdPrice(tokens, 1151111081099710, 'SOL');
  if (normalized === 'BTC') {
    return tokenUsdPrice(tokens, 1, 'WBTC') || tokenUsdPrice(tokens, 56, 'BTCB');
  }
  return 0;
}

function normalizeMarketPrice(marketPrice, marketQuote, referenceQuote, tokens) {
  if (!marketPrice) return 0;
  const normalizedMarketQuote = String(marketQuote || '').toUpperCase();
  if (normalizedMarketQuote && normalizedMarketQuote !== 'USD') {
    return marketPrice;
  }

  const denominator = referenceUnitUsdPrice(tokens, referenceQuote);
  if (!denominator || denominator <= 0) return marketPrice;
  return marketPrice / denominator;
}

function redemptionWaitDays(asset) {
  return asset.waitDays || REDEMPTION_WAIT_DAYS.get(asset.symbol) || 7;
}

function annualizedFromSpread(spreadPct, waitDays) {
  if (spreadPct === null || !Number.isFinite(spreadPct) || waitDays <= 0) return null;
  return (spreadPct / waitDays) * 365;
}

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function opportunityLevel(score, executable, hardA0 = false) {
  if (hardA0 && executable && score >= 90) return 'A0';
  if (executable && score >= 70) return 'A1';
  if (score >= 45) return 'A2';
  return '观察';
}

function scoreRedemptionOpportunity({
  asset,
  spreadPct,
  annualizedPct,
  quality,
  isExecutable,
  missingExecutionMarket,
  conservativeReason,
  executionCaution,
}) {
  if (spreadPct === null || spreadPct <= 0) {
    return {
      opportunityScore: 0,
      opportunityLevel: '观察',
      opportunityReason: spreadPct === null ? '缺少可比较价格' : '当前不是折价赎回方向',
    };
  }

  const spreadScore = clamp(spreadPct * 120, 0, 35);
  const annualizedScore = annualizedPct === null ? 0 : clamp(annualizedPct, 0, 30);
  const sourceScore =
    quality === 'Binance 官方签名接口'
      ? 25
      : quality === '链上汇率'
        ? 20
        : quality === '官方公开接口'
          ? 12
          : 6;
  const executionScore = isExecutable ? 10 : 0;
  const penalty =
    missingExecutionMarket ? 35 :
      conservativeReason ? 30 :
        executionCaution ? 25 :
          annualizedPct === null ? 20 : 0;
  const opportunityScore = Math.round(clamp(
    spreadScore + annualizedScore + sourceScore + executionScore - penalty,
    0,
    100,
  ));
  const hardA0 =
    isExecutable &&
    !REDEMPTION_A0_BLOCKLIST.has(asset.symbol) &&
    spreadPct >= 0.35 &&
    annualizedPct !== null &&
    annualizedPct >= 25 &&
    ['Binance 官方签名接口', '链上汇率'].includes(quality);

  return {
    opportunityScore,
    opportunityLevel: opportunityLevel(opportunityScore, isExecutable, hardA0),
    opportunityReason: conservativeReason
      ? `观察：${conservativeReason}`
      : missingExecutionMarket
        ? '观察：缺少订单簿买入成本'
        : executionCaution
          ? `观察：${executionCaution}`
          : `折价 ${spreadPct.toFixed(3)}%，估算年化 ${annualizedPct === null ? '不计' : `${annualizedPct.toFixed(2)}%`}`,
  };
}

function scoreChainSpreadOpportunity(item) {
  const spreadScore = clamp(item.spreadBps / 2, 0, 35);
  const routeScore = item.routeSupported ? 18 : 5;
  const cautionPenalty = item.routeSupported ? 12 : 25;
  const score = Math.round(clamp(spreadScore + routeScore - cautionPenalty, 0, 100));
  return {
    opportunityScore: score,
    opportunityLevel: opportunityLevel(score, false),
    opportunityReason: item.routeSupported
      ? '理论跨链价差：尚未扣桥费、滑点和目标链出口深度'
      : '观察：当前未接入可执行跨链路径',
  };
}

function scoreExchangeTicker(row) {
  const deviation = Math.abs(row.deviationBps);
  const volumeScore = row.volumeQuote >= 10_000_000 ? 25 : row.volumeQuote >= 1_000_000 ? 18 : 8;
  const score = Math.round(clamp(deviation * 0.9 + volumeScore, 0, 100));
  const executable = row.usable && row.volumeQuote >= MIN_EXCHANGE_QUOTE_VOLUME;
  return {
    opportunityScore: score,
    opportunityLevel: opportunityLevel(score, executable, executable && deviation >= 60),
    opportunityReason: `CEX 偏离 ${row.deviationBps.toFixed(1)} bps，24小时成交额约 ${Math.round(row.volumeQuote).toLocaleString('en-US')} ${row.quote}`,
  };
}

function scoreExchangeSpreadOpportunity(item) {
  const minVolume = Math.min(item.low.volumeQuote || 0, item.high.volumeQuote || 0);
  const volumeScore = minVolume >= 10_000_000 ? 25 : minVolume >= 1_000_000 ? 18 : 8;
  const score = Math.round(clamp(item.spreadBps * 1.4 + volumeScore, 0, 100));
  const executable = item.low.usable && item.high.usable && minVolume >= MIN_EXCHANGE_QUOTE_VOLUME;
  return {
    opportunityScore: score,
    opportunityLevel: opportunityLevel(score, executable, executable && item.spreadBps >= 45),
    opportunityReason: `交易所间价差 ${item.spreadBps.toFixed(1)} bps，仍需核对订单簿和划转限制`,
  };
}

function a0NotificationConfig() {
  const channels = String(process.env.A0_NOTIFY_CHANNELS || '')
    .split(',')
    .map((item) => item.trim().toLowerCase())
    .filter(Boolean);
  const twilioReady = Boolean(
    process.env.TWILIO_ACCOUNT_SID &&
    process.env.TWILIO_AUTH_TOKEN &&
    process.env.TWILIO_FROM &&
    process.env.ALERT_TO,
  );
  const webhookReady = Boolean(process.env.A0_WEBHOOK_URL);

  return {
    enabled: process.env.A0_NOTIFY_ENABLED === '1',
    channels,
    cooldownMinutes: Math.round(A0_NOTIFICATION_COOLDOWN_MS / 60_000),
    smsReady: twilioReady && channels.includes('sms'),
    callReady: twilioReady && channels.includes('call'),
    webhookReady: webhookReady && channels.includes('webhook'),
    configured:
      process.env.A0_NOTIFY_ENABLED === '1' &&
      (
        (twilioReady && (channels.includes('sms') || channels.includes('call'))) ||
        (webhookReady && channels.includes('webhook'))
      ),
  };
}

function a0Message(opportunities) {
  const top = opportunities[0];
  if (!top) return '稳定币看板暂无 A0 复核项';
  return `稳定币看板发现 ${opportunities.length} 个 A0 复核项。最高：${top.title}，分数 ${top.score}。${top.detail}`;
}

function twilioAuthHeader() {
  const raw = `${process.env.TWILIO_ACCOUNT_SID}:${process.env.TWILIO_AUTH_TOKEN}`;
