function getTokenChainPrices(tokens, symbol) {
  const desired = String(symbol).toUpperCase();

  return CORE_CHAIN_IDS.map((chainId) => {
    const candidates = (tokens[String(chainId)] || [])
      .filter((token) => tokenSymbolsMatch(token.symbol, desired))
      .filter((token) => {
        const price = numberFromPath(token.priceUSD);
        const [minPrice, maxPrice] = CHAIN_SPREAD_PRICE_BAND;
        return price >= minPrice && price <= maxPrice;
      });

    const token =
      findCanonicalToken(candidates, chainId, desired) ||
      candidates.find((item) => String(item.coinKey).toUpperCase() === desired) ||
        candidates.find((item) => item.decimals <= 6) ||
        candidates[0];

    if (!token) return null;

    return {
      chainId,
      chain: LIFI_CHAIN_LABELS.get(chainId) || chainId,
      symbol: token.symbol,
      address: token.address,
      price: numberFromPath(token.priceUSD),
    };
  }).filter(Boolean);
}

