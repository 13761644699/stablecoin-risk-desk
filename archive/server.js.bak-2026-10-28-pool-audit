function collectA0Opportunities({ redemptions, exchanges }) {
  const redemptionItems = (redemptions.assets || []).map((asset) => ({
    id: `redemption-${asset.symbol}`,
    source: '赎回价差',
    level: asset.opportunityLevel,
    score: asset.opportunityScore || 0,
    title: `${asset.symbol} 赎回价差`,
    detail: `${asset.opportunityReason || asset.opportunity}；折价 ${asset.spreadPct === null ? '--' : `${asset.spreadPct.toFixed(3)}%`}`,
  }));
  const exchangeSpreadItems = (exchanges.opportunities || []).map((item) => ({
    id: `exchange-spread-${item.symbol}`,
    source: 'CEX价差',
    level: item.opportunityLevel,
    score: item.opportunityScore || 0,
    title: `${item.symbol} CEX 价差`,
    detail: `${item.spreadBps.toFixed(1)} bps；${item.opportunityReason || item.direction}`,
  }));
  const exchangeDepegItems = (exchanges.stableRows || []).map((item) => ({
    id: `exchange-depeg-${item.exchange}-${item.pair}`,
    source: 'CEX脱锚',
    level: item.opportunityLevel,
    score: item.opportunityScore || 0,
    title: `${item.symbol} ${item.exchange} 脱锚`,
    detail: `${item.deviationBps.toFixed(1)} bps；${item.opportunityReason || item.pair}`,
  }));

  return [
    ...redemptionItems,
    ...exchangeSpreadItems,
    ...exchangeDepegItems,
  ]
    .filter((item) => item.level === 'A0')
    .sort((a, b) => b.score - a.score);
}

async function sendA0Notifications(opportunities) {
  const config = a0NotificationConfig();
  if (!config.enabled || !config.configured || !opportunities.length) return [];

  const signature = opportunities.map((item) => item.id).sort().join('|');
  const lastSent = sentA0Notifications.get(signature) || 0;
  if (Date.now() - lastSent < A0_NOTIFICATION_COOLDOWN_MS) return [];

  const message = a0Message(opportunities);
  const sent = [];
  if (config.webhookReady) {
    await sendA0Webhook(opportunities, message);
    sent.push('webhook');
  }
  if (config.smsReady) {
    await sendTwilioSms(message);
    sent.push('sms');
  }
  if (config.callReady) {
    await sendTwilioCall(message);
    sent.push('call');
  }

  sentA0Notifications.set(signature, Date.now());
  notificationState.lastSentAt = new Date().toISOString();
  return sent;
}

async function scanA0Notifications() {
  notificationState.checkedAt = new Date().toISOString();
  const [redemptions, exchanges] = await Promise.all([
    getRedemptionSpreads(),
    getExchangePrices(),
  ]);
  const opportunities = collectA0Opportunities({ redemptions, exchanges });
  notificationState.lastA0Count = opportunities.length;
  notificationState.lastA0 = opportunities.slice(0, 10);

  try {
    await sendA0Notifications(opportunities);
    notificationState.lastError = null;
  } catch (error) {
    notificationState.lastError = error.message;
  }
}

function referenceConfig(asset) {
  return (
    CONTRACT_REFERENCE_OVERRIDES.get(asset.symbol) ||
    ERC4626_REFERENCE_OVERRIDES.get(asset.symbol) ||
    asset.reference
  );
}

function externalReferenceFor(asset, references) {
  return references.get(asset.symbol) || null;
}

function fallbackRedemptionReference(asset) {
  return (
    STATIC_REDEMPTION_REFERENCE_OVERRIDES.get(asset.symbol) ||
    MANUAL_REDEMPTION_RATES.get(asset.symbol) ||
    null
  );
}

function applyRedemptionOverrides(asset, referencePrice, references = new Map()) {
  const externalRate = externalReferenceFor(asset, references);
  if (externalRate?.value > 0) return externalRate.value;

  const fallbackRate = fallbackRedemptionReference(asset);
  if (fallbackRate) return fallbackRate.value;

  if (referencePrice > 0) return referencePrice;

  return 0;
}

function applyMarketOverrides(asset, marketPrice) {
  if (marketPrice > 0) return marketPrice;

  const overrides = {
  };

  return overrides[asset.symbol] || 0;
}

async function getPendleMarkets() {
  return cached('pendle-active-markets', 60_000, () => fetchJson(PENDLE_MARKETS_URL));
}

function daysUntil(dateString) {
  const end = new Date(dateString).getTime();
  if (!Number.isFinite(end)) return null;
  return Math.max(1, Math.ceil((end - Date.now()) / 86_400_000));
}

function pendleMarketForSymbol(markets, symbol) {
  const targets = {
    'PT-sUSDe': ['sUSDe'],
    'PT-USDe': ['USDe'],
    'PT-sUSDS': ['sUSDS', 'stUSDS'],
    'PT-sfrxUSD': ['sfrxUSD', 'frxUSD'],
  }[symbol];
  if (!targets) return null;

  return (markets.markets || [])
    .filter((market) => targets.some((target) => market.name === target))
    .filter((market) => daysUntil(market.expiry) > 0)
    .sort((a, b) => numberFromPath(b.details?.liquidity) - numberFromPath(a.details?.liquidity))[0] || null;
}

function applyPendleData(asset, marketPrice, referencePrice, waitDays, pendleMarkets) {
  const market = pendleMarketForSymbol(pendleMarkets, asset.symbol);
  if (!market) return { marketPrice: 0, referencePrice: 0, waitDays, pendleMarket: null };

  const days = daysUntil(market.expiry) || waitDays;
  const impliedApy = numberFromPath(market.details?.impliedApy);
  const ptPrice =
    impliedApy > 0
      ? 1 / (1 + impliedApy * (days / 365))
      : marketPrice;

  return {
    marketPrice: ptPrice || marketPrice,
    referencePrice: referencePrice || 1,
    waitDays: days,
    pendleMarket: {
      name: market.name,
      expiry: market.expiry,
      impliedApy: impliedApy * 100,
      liquidity: numberFromPath(market.details?.liquidity),
      address: market.address,
    },
  };
}

function marketQuality(asset, originalMarketPrice, marketPrice) {
  if (originalMarketPrice > 0) return asset.market.type === 'manual' ? '人工录入' : '实时市场';
  if (marketPrice > 0) return '人工参考';
  return '待接';
}

function referenceQuality(asset, referencePrice, wasMissing) {
  const fallbackRate = fallbackRedemptionReference(asset);
  if (fallbackRate) return fallbackRate.quality;

  const reference = referenceConfig(asset);
  if (reference.type === 'erc4626' || reference.type === 'contract') return '链上汇率';
  if (reference.type === 'manual' && !wasMissing) return '人工参考';
  if (reference.type === 'same-as-market') return '市场参考';
  if (reference.type === 'binance-market') return '交易所参考';
  if (referencePrice > 0) return wasMissing ? '市场隐含' : '人工参考';
  return '待接';
}

function opportunityTag(spreadPct, annualizedPct, quality) {
  if (quality === '市场隐含' || spreadPct === null || annualizedPct === null) return null;
  if (spreadPct <= 0 || annualizedPct <= 0) return null;
  if (annualizedPct >= 25 && spreadPct >= 0.2) return '重点复核';
  if (annualizedPct >= 8 && spreadPct >= 0.05) return '可关注';
  return null;
}

function conservativePolicyFor(asset, quality) {
  const reason = CONSERVATIVE_PRICING_POLICIES.get(asset.symbol);
  if (reason) return reason;
  if (CORE_REDEMPTION_SYMBOLS.has(asset.symbol)) return null;
  if (quality === 'Jupiter 路由报价') return '路由报价只代表小额 swap 出口，不等于协议赎回价';
  if (quality === '公开价格参考') return '公开价格参考不等于可执行赎回价';
  if (quality === '人工参考') return '人工参考价不等于实时可执行赎回价';
  return null;
}

function executionCautionFor(asset, marketType, executionMarket) {
  if (CORE_REDEMPTION_SYMBOLS.has(asset.symbol)) return null;
  if (executionMarket) return null;
  if (marketType === 'binance') {
    return asset.symbol === 'USDe'
      ? null
      : '缺少订单簿买入成本';
  }
  if (asset.kind.includes('RWA')) return 'RWA/NAV 赎回涉及账户资格、窗口和结算，不能按即时可执行复核处理';
  if (asset.kind.includes('Pendle')) return 'Pendle 到期赎回必须核对具体市场、到期日和二级市场深度';
  if (asset.kind.includes('BTC')) return 'BTC 凭证退出涉及托管、跨链或解锁流程，暂按观察口径';
  if (asset.kind.includes('LRT')) return 'LRT 退出队列、额度和底层资产未实时接入，暂按观察口径';
  if (asset.kind.includes('LST')) return 'LST 市场价来自聚合价格，不含买入深度、退出队列和滑点';
  if (marketType === 'lifi-token' || marketType === 'llama') {
