  return { key, secret, ready: Boolean(key && secret) };
}

async function fetchBinanceSigned(path, params = {}) {
  const credentials = binanceCredentials();
  if (!credentials.ready) return null;

  const timeOffsetMs = await getBinanceTimeOffsetMs();
  const query = new URLSearchParams({
    ...params,
    timestamp: String(Date.now() + timeOffsetMs),
    recvWindow: '60000',
  });
  const signature = crypto
    .createHmac('sha256', credentials.secret)
    .update(query.toString())
    .digest('hex');
  query.set('signature', signature);

  return fetchJson(`https://api.binance.com${path}?${query.toString()}`, {
    headers: {
      'X-MBX-APIKEY': credentials.key,
    },
  });
}

