function exchangePriceUsable(row) {
  if (!row) return false;
  if (['ETH', 'SOL', 'BTC'].includes(row.quote)) return true;
  return row.price >= 0.97 &&
    row.price <= 1.03 &&
    row.volumeQuote >= MIN_EXCHANGE_QUOTE_VOLUME;
}

function stableQuoteUsdPrices(rows) {
  const prices = new Map([['USD', 1]]);
  const usdtUsdRows = rows
    .filter((row) => row.symbol === 'USDT' && row.quote === 'USD' && row.price > 0)
    .map((row) => row.price)
    .sort((a, b) => a - b);

  if (usdtUsdRows.length) {
    prices.set('USDT', usdtUsdRows[Math.floor(usdtUsdRows.length / 2)]);
  } else {
    prices.set('USDT', 1);
  }

  return prices;
}

function exchangeUsdPrice(row, quoteUsdPrices) {
  if (!row) return 0;
  if (['ETH', 'SOL', 'BTC'].includes(row.quote)) return row.price;
  return row.price * (quoteUsdPrices.get(row.quote) || 1);
}

function exchangeSideUsdPrice(row, side, quoteUsdPrices) {
  if (!row) return 0;
  const rawPrice = side === 'buy' ? row.ask : row.bid;
  const price = rawPrice > 0 ? rawPrice : row.price;
  if (['ETH', 'SOL', 'BTC'].includes(row.quote)) return price;
  return price * (quoteUsdPrices.get(row.quote) || 1);
}

function exchangeDeviationBps(row, quoteUsdPrices = new Map([['USD', 1], ['USDT', 1]])) {
  const price = exchangeUsdPrice(row, quoteUsdPrices);
  return (price - 1) * 10_000;
}

async function getExchangePrices() {
  const rows = (
    await Promise.all(
      [...EXCHANGE_STABLE_MARKETS, ...EXCHANGE_REDEMPTION_MARKETS].map(fetchExchangeTicker),
    )
  ).filter(Boolean);

  const quoteUsdPrices = stableQuoteUsdPrices(rows);

  const stableRows = rows
    .filter((row) => EXCHANGE_STABLE_MARKETS.some((item) => item.pair === row.pair && item.exchange === row.exchange))
    .map((row) => {
      const enriched = {
        ...row,
        usdPrice: exchangeUsdPrice(row, quoteUsdPrices),
        buyUsdPrice: exchangeSideUsdPrice(row, 'buy', quoteUsdPrices),
        sellUsdPrice: exchangeSideUsdPrice(row, 'sell', quoteUsdPrices),
        usable: exchangePriceUsable(row),
        deviationBps: exchangeDeviationBps(row, quoteUsdPrices),
        alert: exchangePriceUsable(row) && Math.abs(exchangeDeviationBps(row, quoteUsdPrices)) >= 10,
      };
      return {
        ...enriched,
        ...scoreExchangeTicker(enriched),
      };
    });

  const redemptionRows = rows
    .filter((row) => EXCHANGE_REDEMPTION_MARKETS.some((item) => item.pair === row.pair && item.exchange === row.exchange))
    .map((row) => ({
      ...row,
      usable: true,
      deviationBps: exchangeDeviationBps(row),
      alert: Math.abs(exchangeDeviationBps(row)) >= 10,
    }));

  const bySymbol = new Map();
  for (const row of stableRows.filter((item) => item.usable)) {
    const list = bySymbol.get(row.symbol) || [];
    list.push(row);
    bySymbol.set(row.symbol, list);
  }

  const opportunities = [...bySymbol.entries()]
    .map(([symbol, list]) => {
      if (list.length < 2) return null;
      const low = list.reduce((best, item) => (item.buyUsdPrice < best.buyUsdPrice ? item : best), list[0]);
      const high = list.reduce((best, item) => (item.sellUsdPrice > best.sellUsdPrice ? item : best), list[0]);
      const spreadBps = (high.sellUsdPrice - low.buyUsdPrice) * 10_000;
      return {
        symbol,
        low,
        high,
        spreadBps,
        alert: spreadBps >= 5,
        direction: `${low.exchange} 按卖一买入，${high.exchange} 按买一卖出`,
      };
    })
    .filter(Boolean)
    .map((item) => ({
      ...item,
      ...scoreExchangeSpreadOpportunity(item),
    }))
    .sort((a, b) => b.spreadBps - a.spreadBps);

  return {
    updatedAt: new Date().toISOString(),
    source: 'Binance + OKX + Gate + Coinbase public tickers',
    stableRows: stableRows.sort((a, b) => Math.abs(b.deviationBps) - Math.abs(a.deviationBps)),
    redemptionRows,
    opportunities,
  };
}

async function getStablecoinChainSpreads() {
  const tokens = await getLifiTokens();
  const opportunities = CHAIN_SPREAD_SYMBOLS.map((symbol) => {
    const usable = getTokenChainPrices(tokens, symbol);

    if (usable.length < 2) return null;

    const low = usable.reduce((best, item) => (item.price < best.price ? item : best), usable[0]);
    const high = usable.reduce((best, item) => (item.price > best.price ? item : best), usable[0]);
    const mid = (low.price + high.price) / 2;
    const spreadBps = mid > 0 ? ((high.price - low.price) / mid) * 10_000 : 0;

    const item = {
      symbol,
      low,
      high,
      spreadBps,
      alert: spreadBps >= CHAIN_SPREAD_ALERT_BPS,
      direction: `买入 ${low.chain}，跨到 ${high.chain} 卖出`,
      routeSupported:
        ROUTE_TOKENS.includes(symbol) &&
        CORE_CHAIN_IDS.includes(low.chainId) &&
        CORE_CHAIN_IDS.includes(high.chainId),
      chainPrices: usable.sort((a, b) => a.price - b.price).slice(0, 8),
    };
    return {
      ...item,
      ...scoreChainSpreadOpportunity(item),
    };
  })
    .filter((item) => item && item.spreadBps >= 1)
    .sort((a, b) => b.spreadBps - a.spreadBps);

  return {
    updatedAt: new Date().toISOString(),
    source: 'LI.FI token price',
    thresholdBps: CHAIN_SPREAD_ALERT_BPS,
    opportunities,
  };
}

function parseAmount(amount, decimals) {
  const value = Number(amount);
  if (!Number.isFinite(value) || value <= 0) {
    throw new Error('Amount must be greater than 0');
  }
  return BigInt(Math.floor(value * 10 ** Math.min(decimals, 8))).toString() +
    '0'.repeat(Math.max(decimals - Math.min(decimals, 8), 0));
}

function summarizeStep(step) {
  return {
    id: step.id,
    type: step.type,
    tool: step.tool,
    toolName: step.toolDetails?.name || step.tool,
    fromChainId: step.action?.fromChainId,
    toChainId: step.action?.toChainId,
    fromChain: LIFI_CHAIN_LABELS.get(step.action?.fromChainId) || step.action?.fromChainId,
    toChain: LIFI_CHAIN_LABELS.get(step.action?.toChainId) || step.action?.toChainId,
    fromToken: step.action?.fromToken?.symbol,
    toToken: step.action?.toToken?.symbol,
    fromAmount: step.estimate?.fromAmount,
    toAmount: step.estimate?.toAmount,
    executionDuration: step.estimate?.executionDuration || 0,
    gasUsd: (step.estimate?.gasCosts || []).reduce(
      (sum, item) => sum + numberFromPath(item.amountUSD),
      0,
    ),
    feeUsd: (step.estimate?.feeCosts || []).reduce(
      (sum, item) => sum + numberFromPath(item.amountUSD),
      0,
    ),
  };
}

function summarizeRoute(route) {
  const steps = (route.includedSteps || []).map(summarizeStep);
  const bridgeTools = [
    ...new Set(
      steps
        .filter((step) => step.type === 'cross' || step.fromChainId !== step.toChainId)
        .map((step) => step.toolName)
        .filter(Boolean),
    ),
  ];

  return {
    id: route.id,
    tool: route.tool,
    bridgeTools,
    fromAmount: route.estimate?.fromAmount,
    toAmount: route.estimate?.toAmount,
    toAmountMin: route.estimate?.toAmountMin,
    fromAmountUSD: numberFromPath(route.estimate?.fromAmountUSD),
    toAmountUSD: numberFromPath(route.estimate?.toAmountUSD),
    executionDuration: route.estimate?.executionDuration || 0,
    gasUsd: (route.estimate?.gasCosts || []).reduce(
      (sum, item) => sum + numberFromPath(item.amountUSD),
      0,
    ),
    feeUsd: (route.estimate?.feeCosts || []).reduce(
      (sum, item) => sum + numberFromPath(item.amountUSD),
      0,
    ),
    steps,
  };
}

async function getRoutes(query) {
  const fromChain = Number(query.fromChain || 8453);
  const toChain = Number(query.toChain || 42161);
  const symbol = String(query.symbol || 'USDC').toUpperCase();
  const amount = String(query.amount || '1000');
  const fromAddress =
    query.fromAddress ||
    '0x0000000000000000000000000000000000000001';

  if (fromChain === toChain) {
    throw new Error('请选择两条不同的链');
  }

  const tokens = await getLifiTokens();
  const fromToken = chooseToken(tokens, fromChain, symbol);
  const toToken = chooseToken(tokens, toChain, symbol);

  if (!fromToken || !toToken) {
    throw new Error(`当前链对暂时没有找到可用的 ${symbol} 跨链路径，可能需要选择 USDC、USD1，或确认该链上是否为 USDT0/桥接版本`);
  }

  const amountRaw = parseAmount(amount, fromToken.decimals);
  const params = new URLSearchParams({
    fromChain: String(fromChain),
    toChain: String(toChain),
    fromToken: fromToken.address,
    toToken: toToken.address,
    fromAmount: amountRaw,
    fromAddress,
    toAddress: fromAddress,
    slippage: '0.003',
  });

  const cacheKey = `route-${fromChain}-${toChain}-${tokenKey(fromToken)}-${tokenKey(
    toToken,
  )}-${amountRaw}`;
  const route = await cached(cacheKey, TTL.routes, () =>
    fetchJson(`${LIFI_BASE}/quote?${params.toString()}`),
  );

  return {
    updatedAt: new Date().toISOString(),
    source: 'LI.FI Quote API',
    request: {
      fromChain,
      toChain,
      symbol,
      amount: Number(amount),
      fromToken: {
        symbol: fromToken.symbol,
        address: fromToken.address,
        decimals: fromToken.decimals,
      },
      toToken: {
        symbol: toToken.symbol,
        address: toToken.address,
        decimals: toToken.decimals,
      },
    },
    route: summarizeRoute(route),
  };
}

