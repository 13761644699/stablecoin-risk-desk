// 最快套利路径推荐（规则版，供慢线 enrich 流程在确认"流动性脱锚"后调用）。
// 返回多行：主路径（币安，有现货才走）+ 备选（链上）。用户 2026-10-03 纠正：
// 1) 有些币币安无现货（PYUSD/USDg/USDD），走不了币安退出；2) 折价不一定要在币安卖，链上等回归卖出也是路。
export function fastestArbPath(symbol, chain, price) {
  const lanes = (BINANCE_FAST_LANES[symbol] || []).slice().sort((a, b) => a.timeMin - b.timeMin);
  const hasSpot = !!BINANCE_SPOT_LISTED[symbol];
  const px = price.toFixed(4);
  const lines = [];
  if (price < 1) {
    // 折价：在链上买入便宜的币
    if (hasSpot && lanes.length) {
      const sameChain = lanes.find((l) => l.chain === chain);
      const lane = sameChain || lanes[0];
      // 脱锚链与充值链不一致时（如 Solana 脱锚但只能走 ERC20 充值），必须先跨链桥
      const bridgeLeg = lane.bridgeFrom && lane.bridgeFrom === chain && lane.bridgeNote
        ? ` → ${lane.bridgeNote}` : '';
      const unver = lane.unverified ? '（⚠️该网络充值支持待核实，动手前在币安充值页确认）' : '';
      lines.push(`主路径（币安）：在 ${chain} 按 $${px} 买入 ${symbol}${bridgeLeg} → 经币安 ${lane.network}（约 ${lane.timeMin} 分钟）充入${unver} → 在币安按市价卖出`);
    } else if (!hasSpot) {
      const alts = (ALT_EXIT_VENUES[symbol] || [])
        .map(v => `${v.venue} ${v.pair}（充值网络 ${v.nets}，${v.cost}）`).join('；');
      lines.push(`主路径（其他所）：币安无 ${symbol} 现货。在 ${chain} 按 $${px} 买入 → 充到以下任一所卖出：${alts || '暂无已验证退出所，链上持有等回归'}`);
      lines.push(`备选（链上）：在 ${chain} 按 $${px} 买入 → 不跨所，在 DEX 等回归后卖出（承担不回归风险）`);
    } else {
      lines.push(`主路径：在 ${chain} 按 $${px} 买入 ${symbol}（币安快线暂无配置，手动确认充值网络）`);
      lines.push(`备选（链上）：在 ${chain} 按 $${px} 买入 ${symbol} → 不跨所，在 DEX 等回归后卖出。无跨所时间/手续费，但承担价格不回归的风险`);
    }
  } else {
    // 溢价：在币安买入 → 提到脱锚链卖出
    if (hasSpot && lanes.length) {
      const sameChain = lanes.find((l) => l.chain === chain);
      const lane = sameChain || lanes[0];
      const bridgeOut = lane.chain !== chain
        ? ` → 再经跨链桥至 ${chain}（如 LI.FI，约 5-10 分钟 + 桥费）` : '';
      const unver = lane.unverified ? '（⚠️该网络提币支持待核实，动手前在币安提币页确认）' : '';
      lines.push(`主路径（币安）：在币安买入 ${symbol} → 经 ${lane.network}（约 ${lane.timeMin} 分钟）提到 ${lane.chain}${bridgeOut}${unver} → 在链上按 $${px} 卖出`);
    } else {
      lines.push(`主路径：在有 ${symbol} 现货的交易所买入 → 提到 ${chain} → 在链上按 $${px} 卖出（币安无现货，走不了币安买入）`);
    }
  }
  if (!lanes.length && hasSpot) return '暂无该币种的币安快线配置';
  return lines.join('\n');
}
