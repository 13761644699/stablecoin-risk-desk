// depeg_logic.mjs — 脱锚判定纯逻辑（无 IO），server.js 与回测脚本共用，
// 避免两套逻辑打架。改阈值语义只改这里。
export const DEFAULT_WARN_BPS = 50; // 预警线 ±0.5%
export const DEFAULT_SEVERE_BPS = 150; // 严重线 ±1.5%
export const DEFAULT_CLEAR_BPS = 30; // 回到 ±0.3% 以内解除

// devBps: 以 bps 计的偏离（相对 $1 锚），正数=溢价，负数=折价
export function classifyDepeg(devBps, warnBps = DEFAULT_WARN_BPS, severeBps = DEFAULT_SEVERE_BPS) {
  const abs = Math.abs(devBps);
  if (abs >= severeBps) return 'severe';
  if (abs >= warnBps) return 'warn';
  return null;
}

export function isCleared(devBps, clearBps = DEFAULT_CLEAR_BPS) {
  return Math.abs(devBps) <= clearBps;
}

// 双源交叉验证：主源（最深池）检出脱锚后，用副源（同链第二池 / CEX 参考）复核。
// secondaryDevBps: 副源同期的偏离 bps；null/NaN 表示副源无数据。
// 返回：
//   'confirmed'   副源同向且同样越过阈值 → 真脱锚
//   'likely'      副源同向、幅度 ≥ 阈值一半 → 大概率真
//   'suspicious'  副源正常或反向 → 主源疑似坏点（如 USDG 2026-04-04 式聚合坏点）
//   'unconfirmed' 副源无数据 → 无法复核，保守放行并标注
// 注意：链特异性脱锚（某链脱、聚合价正常）是真机会——复核必须用"同链"第二源，
// 绝不能用聚合价/其他链价格去否决链级信号。
export function confirmDepeg(primaryDevBps, secondaryDevBps, warnBps = DEFAULT_WARN_BPS) {
  if (secondaryDevBps === null || secondaryDevBps === undefined || !Number.isFinite(secondaryDevBps)) {
    return 'unconfirmed';
  }
  const p = Math.abs(primaryDevBps);
  const s = Math.abs(secondaryDevBps);
  const sameSign =
    primaryDevBps === 0 || secondaryDevBps === 0 ||
    Math.sign(primaryDevBps) === Math.sign(secondaryDevBps);
  if (s >= warnBps && sameSign) return 'confirmed';
  if (s >= warnBps * 0.5 && sameSign) return 'likely';
  return 'suspicious';
}

export function devBpsFromPrice(price) {
  if (!Number.isFinite(price) || price <= 0) return null;
  return ((price - 1) / 1) * 10_000;
}

// 池子失衡比先行指标（2026-10-03）：我方币种占池子 USD 价值的比例。
// base 即我们的币（调用方已按地址匹配），quote 为对手方。
// 返回 0-100 的百分比；>=65 意味着我方被持续卖入池子（折价先兆），<=35 意味着被持续买走（溢价先兆）。
// 注意：集中流动性池（Orca Whirlpool/Uniswap V3）reserves 只反映当前 tick 区间，指标偏噪，仅作先行参考不单独报警。
export function poolImbalance(liqBase, liqQuote, priceUsd, priceNative) {
  if (!(liqBase > 0) || !(liqQuote > 0) || !(priceUsd > 0) || !(priceNative > 0)) return null;
  const baseUsd = liqBase * priceUsd;
  const quoteUsd = liqQuote * (priceUsd / priceNative);
  if (!(quoteUsd > 0)) return null;
  return (baseUsd / (baseUsd + quoteUsd)) * 100;
}

// 失衡信号：'sell-pressure' | 'buy-pressure' | null
export function imbalanceSignal(imb) {
  if (imb === null || imb === undefined) return null;
  if (imb >= 65) return 'sell-pressure';  // 我方占比过高 → 被卖入池子
  if (imb <= 35) return 'buy-pressure';   // 我方占比过低 → 被买走
  return null;
}

// 事件严重程度分级 S/A/B/C（由小时线回测 v2 的 32 个"首次即严重+双源"事件沉淀而来，
// 标准见 backtest_report.md「事件分级标准」节；回测与线上共用，保证口径一致）。
//
// 输入 event: {
//   peakDevBps: number,  // 事件至今最大偏离（bps，取绝对值比较）
//   durHours: number,     // 已持续小时数（未知传 0）
//   verdict: 'confirmed' | 'likely' | 'unconfirmed',  // 双源交叉结论
//   breadth: 'single' | 'multi-chain' | 'whole-coin',
//     // single=单链；multi-chain=同币≥2链24h内严重；whole-coin=币安现货同期偏离≥50bps
// }
// 规则按序命中（前后一致，无双标）；
// 另：链特异性（single + 币安现货基本不动）是"套利窗口"属性，由调用方在 cexDevBps<=30 时单独标注，
// 不改变评级——评级只回答"有多严重"，套利属性回答"能不能做"。
export function gradeDepegEvent(event) {
  const p = Math.abs(Number(event?.peakDevBps) || 0);
  const d = Number(event?.durHours) || 0;
  const v = event?.verdict;
  const b = event?.breadth || 'single';
  if (b === 'whole-coin') return 'S';                    // 全币种联动：暴雷风险最高
  if (b === 'multi-chain') return 'S';                   // 多链同币：非单点流动性问题
  if (p >= 300 && v === 'confirmed') return 'S';         // 单链极端偏离且双源确认
  if (p >= 250) return 'A';
  if (p >= 200 && v === 'confirmed') return 'A';
  if (p >= 150 && d >= 24) return 'A';
  if (p >= 200) return 'B';
  if (p >= 150 && d >= 4) return 'B';
  return 'C';                                            // 150~200bps 短时 wiggle
}

